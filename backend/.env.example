# CakeStore API - Backend Environment Template
# Copy to backend/.env for local overrides or container runtime.

DB_URL=jdbc:postgresql://localhost:5432/cake_platform
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password_here
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

JWT_SECRET=your_64_char_hex_jwt_secret_here
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

RAZORPAY_KEY_ID=rzp_test_or_live_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

FILE_UPLOAD_DIR=uploads
SHOW_SQL=false

# Resend Email Configuration (Production)
SPRING_MAIL_HOST=smtp.resend.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=resend
SPRING_MAIL_PASSWORD=your_resend_api_key_here
MAIL_FROM_ADDRESS=noreply@yourdomain.com
RESEND_API_KEY=your_resend_api_key_here
