# CakeStore Platform - Root Environment Template
# Copy this file to .env and configure real production values before deployment.
# NEVER commit .env to version control.

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/cake_platform
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password_here
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# JWT Security (Required - no default fallback in production)
JWT_SECRET=your_64_char_hex_jwt_secret_here
JWT_EXPIRATION_MS=86400000

# CORS & Domain Safety (Comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Razorpay Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_or_live_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Storage & Uploads
FILE_UPLOAD_DIR=uploads

# Observability
SHOW_SQL=false
SPRING_PROFILES_ACTIVE=prod

# Local development only. Keep disabled in staging/production.
APP_DEMO_DATA_ENABLED=false
